<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="10dp" android:gravity="center_vertical" android:background="@drawable/row_bg">

    <ImageView android:id="@+id/cover" android:layout_width="56dp" android:layout_height="56dp"
        android:scaleType="centerCrop" android:background="@drawable/round" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="18dp">
        <TextView android:id="@+id/line1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="22sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"
            android:textColor="@color/on_focus" />
        <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="17sp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/on_focus_dim" />
    </LinearLayout>

    <ImageView android:id="@+id/playing" android:layout_width="26dp" android:layout_height="26dp"
        android:layout_marginStart="12dp" android:src="@drawable/ic_eq" android:tint="@color/on_focus" android:visibility="gone" />

    <TextView android:id="@+id/right" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="18sp" android:layout_marginStart="16dp" android:textColor="@color/on_focus_dim" />
</LinearLayout>
