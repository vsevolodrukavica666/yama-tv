<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:padding="48dp">

    <ImageView android:id="@+id/qr" android:layout_width="320dp" android:layout_height="320dp"
        android:layout_marginEnd="64dp" android:background="#FFFFFFFF" android:padding="12dp" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Вход в Яндекс Музыку" android:textSize="36sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="Наведи камеру телефона на QR или открой" android:textSize="22sp" android:textColor="@color/dim" />
        <TextView android:id="@+id/url" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="28sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="и введи код:" android:textSize="22sp" android:textColor="@color/dim" />
        <TextView android:id="@+id/code" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="…" android:textSize="64sp" android:textStyle="bold" android:textColor="@color/focus"
            android:letterSpacing="0.15" />
    </LinearLayout>
</LinearLayout>
