<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <!-- ambient background: the art by default, a blurred cover of whatever is focused -->
    <ImageView android:id="@+id/ambient" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/art_bg" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ambient_scrim" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout android:layout_width="88dp" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:background="#990B0B0E" android:paddingTop="26dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="28dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ya" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ma" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/focus" />
            </LinearLayout>
            <ImageButton android:id="@+id/navHome" style="@style/NavBtn" android:src="@drawable/ic_home" android:contentDescription="Главная" />
            <ImageButton android:id="@+id/navLikes" style="@style/NavBtn" android:src="@drawable/ic_like_off" android:contentDescription="Мне нравится" />
            <ImageButton android:id="@+id/navPlaylists" style="@style/NavBtn" android:src="@drawable/ic_playlist" android:contentDescription="Плейлисты" />
            <ImageButton android:id="@+id/navSettings" style="@style/NavBtn" android:src="@drawable/ic_settings" android:contentDescription="Настройки" />
        </LinearLayout>

        <ScrollView android:id="@+id/scroll" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:scrollbars="none"
            android:requiresFadingEdge="vertical" android:fadingEdgeLength="96dp">
            <!-- the fade length is also how far a focused row stays from the edges, clear of the mini player -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="44dp" android:paddingBottom="120dp" android:clipToPadding="false">

                <!-- negative margin + padding: room for the zoomed button inside the hero's own bounds -->
                <FrameLayout android:layout_width="match_parent" android:layout_height="280dp"
                    android:layout_marginStart="-20dp" android:paddingStart="20dp" android:clipChildren="false" android:clipToPadding="false">
                    <LinearLayout android:id="@+id/searchBtn" style="@style/Pill" android:layout_gravity="top|end"
                        android:layout_marginTop="20dp" android:layout_marginEnd="8dp">
                        <ImageView style="@style/PillIcon" android:src="@drawable/ic_search" />
                        <TextView style="@style/PillText" android:text="Поиск" />
                    </LinearLayout>
                    <dev.yama.OrbView android:layout_width="280dp" android:layout_height="280dp"
                        android:layout_gravity="end|center_vertical" android:layout_marginEnd="30dp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Моя волна" android:textSize="58sp" android:textStyle="bold"
                            android:shadowColor="#99000000" android:shadowRadius="16" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Музыка под твоё настроение" android:textSize="22sp" android:textColor="#FFDDDDDD" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="22dp" android:clipChildren="false" android:clipToPadding="false">
                            <LinearLayout android:id="@+id/waveBtn" style="@style/Pill"
                                android:layout_height="64dp" android:layout_marginStart="0dp"
                                android:paddingHorizontal="30dp" android:background="@drawable/pill_primary">
                                <ImageView style="@style/PillIcon" android:src="@drawable/ic_play" android:tint="#FF121212" />
                                <TextView style="@style/PillText" android:text="Слушать" android:textSize="22sp" android:textColor="#FF121212" />
                            </LinearLayout>
                            <LinearLayout android:id="@+id/clipsBtn" style="@style/Pill"
                                android:layout_height="64dp" android:layout_marginStart="20dp" android:paddingHorizontal="30dp">
                                <ImageView style="@style/PillIcon" android:src="@drawable/ic_video" />
                                <TextView style="@style/PillText" android:text="Клипы" android:textSize="22sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <TextView android:id="@+id/likesTitle" style="@style/Section" android:text="Мне нравится" />
                <HorizontalScrollView style="@style/Rail">
                    <LinearLayout android:id="@+id/likesRow" style="@style/RailRow" />
                </HorizontalScrollView>

                <!-- personal waves: a titled rail per group, filled from code; shifted left so rails keep the zoom room -->
                <LinearLayout android:id="@+id/waves" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="-12dp" />
                <LinearLayout android:id="@+id/radio" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="-12dp" />

                <TextView android:id="@+id/playlistsTitle" style="@style/Section" android:text="Плейлисты" android:visibility="gone" />
                <HorizontalScrollView style="@style/Rail">
                    <LinearLayout android:id="@+id/playlistsRow" style="@style/RailRow" />
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- mini player, only while something is loaded -->
    <LinearLayout android:id="@+id/now" android:layout_width="400dp" android:layout_height="80dp"
        android:layout_gravity="bottom|end" android:layout_margin="22dp"
        android:background="@drawable/glass" android:foreground="@drawable/focus_ring"
        android:gravity="center_vertical" android:padding="10dp"
        android:focusable="true" android:clickable="true" android:visibility="gone">
        <ImageView android:id="@+id/nowCover" android:layout_width="60dp" android:layout_height="60dp"
            android:scaleType="centerCrop" android:background="@drawable/round" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginHorizontal="14dp">
            <TextView android:id="@+id/nowTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="18sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/nowArtist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textColor="@color/dim" android:singleLine="true" android:ellipsize="end" />
            <ProgressBar android:id="@+id/nowBar" style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp"
                android:progressDrawable="@drawable/progress_bar" android:max="1000" />
        </LinearLayout>
        <ImageView android:id="@+id/nowState" android:layout_width="30dp" android:layout_height="30dp"
            android:layout_marginEnd="8dp" android:src="@drawable/ic_eq" android:tint="@color/focus" />
    </LinearLayout>
</FrameLayout>
